# HUUID EMR Stub -- configuration template
# Copy this file to .env and fill in the values, then run:
#   npm install && npm run generate-local-secret && npm run start
#
# NOTE ON THIS FILE'S ORIGIN: HUUID-EMR-STUB-v0.1.2.docx has no "Section 6" --
# the document only goes up to Section 5. The three fields below marked
# "doc-mandated" are the only config fields the document names anywhere
# (Section 4, install step 3). Everything below that is here because the
# code in this repo needs it, not because the spec named it.

# ---- Doc-mandated (Section 4, install step 3) ----
HUUID_FACILITY_DID=did:huuid:gh:your-facility-node-id
HUUID_API_KEY=your-facility-api-key
HUUID_FACILITY_CODE=GH-XXX-001

# ---- Implementation-necessary: resolver connection ----
# Default points at the actual live Month 2/3 deployment (huuid-resolver.vercel.app).
# The spec's canonical host (resolver.huuid.health) is not a live DNS target yet.
HUUID_RESOLVER_BASE_URL=https://huuid-resolver.vercel.app
HUUID_RESOLVER_TIMEOUT_MS=3000

# ---- Implementation-necessary: local Express server bind address (Step 7) ----
STUB_PORT=3741
STUB_HOST=localhost

# ---- Implementation-necessary: local-auth shared secret file path (Step 6) ----
# Generated by `npm run generate-local-secret` -- do not put the secret value
# itself in this .env file, only the path to it.
HUUID_LOCAL_AUTH_SECRET_PATH=./local-auth/emr-secret.key

# ---- Implementation-necessary: facility signing key paths ----
# `npm run download-keys` cannot fetch these yet -- the live resolver has no
# key-distribution endpoint. Place a PKCS8-PEM Ed25519 private key here
# manually until that exists. See README.md.
HUUID_FACILITY_PRIVATE_KEY_PATH=./keys/facility-private-key.pem
# Reserved for offline QR/token verification -- not used until QR
# verification is built (explicitly deferred for this build step).
HUUID_RESOLVER_PUBLIC_KEY_PATH=./keys/resolver-public-key.pem

# ---- Implementation-necessary: local SQLite cache ----
HUUID_CACHE_DB_PATH=./data/huuid-cache.db

# Emergency override for integrity violations.
# Set to 1 only under instruction from Root Authority.
# Every use is reported to josephtdnarnor@gmail.com
HUUID_INTEGRITY_OVERRIDE=0
